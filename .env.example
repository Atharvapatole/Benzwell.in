# =============================================================================
# BENZWELL — VERCEL PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Official Website: https://benzwell.in
# Official Support: info@benzwell.in
# =============================================================================

# =============================================================================
# 1. PUBLIC VARIABLES (Exposed to Browser / Client-Side)
# =============================================================================

# Platform Canonical URL (Set to https://benzwell.in in Production)
NEXT_PUBLIC_SITE_URL=https://benzwell.in

# Supabase Auth & Storage (New Supabase Project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ImageKit Public CDN (Public Product Covers & Thumbnails)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key

# Razorpay Client-Side Key ID (Public Key: rzp_live_xxx or rzp_test_xxx)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx

# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID (Format: 15-16 digit number)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Tag Manager Container ID (Format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_GTM_ID=


# =============================================================================
# 2. SERVER-ONLY SECRET VARIABLES (Never Exposed to Browser / Client-Side)
# =============================================================================

# Database Credential Encryption Key (32-byte hex key for encrypting secrets in DB)
CREDENTIAL_ENCRYPTION_KEY=

# Supabase Service Role Key (Private Storage management & signed download URLs)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PRIVATE_BUCKET=products-private

# ImageKit Server API (Public media uploads & management)
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key

# Appwrite Enterprise Backend (Application Database & Free Tool Deployments)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-appwrite-secret-api-key
APPWRITE_DATABASE_ID=your-appwrite-database-id
APPWRITE_WEBHOOK_SECRET=

# Razorpay Server-Side Payment Gateway Secrets
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend Transactional Email API Configuration
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=info@benzwell.in
RESEND_FROM_NAME=BenzWell
RESEND_REPLY_TO=info@benzwell.in

# Google OAuth 2.0 Credentials (Configured in Google Cloud Console & Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Free Tools & Deployment Manager Configuration
FREE_TOOLS_BASE_DOMAIN=benzwell.in
FREE_TOOLS_APPWRITE_COLLECTION_ID=free_tools

# GitHub Integration (Automated Tool Deployment & Sync)
GITHUB_ACCESS_TOKEN=
GITHUB_OWNER=Atharvapatole
GITHUB_REPO=Benzwell

# Support AI Multi-Provider Fallback (Priority 1: Groq -> Priority 2: Mistral -> Priority 3: Gemini)
GROQ_API_KEY=
GROQ_SUPPORT_MODEL=llama-3.3-70b-versatile

MISTRAL_API_KEY=
MISTRAL_SUPPORT_MODEL=mistral-large-latest

GEMINI_API_KEY=
GEMINI_SUPPORT_MODEL=gemini-1.5-flash

# Admin Support Notification Destination Email
ADMIN_NOTIFICATION_EMAIL=ceo.office.atharva@gmail.com

# Meta (Facebook) Marketing & Conversions API (Optional)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
